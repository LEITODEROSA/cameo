# Copiá este archivo a .env.local y completá las keys que tengas.
# Sin ellas, el dashboard funciona igual (carga manual); estas variables
# sólo habilitan los botones de sincronización en /dashboard/integraciones.

# Apify (scraping de contenido público: posts/reels IG, TikTok, Meta Ad Library) — apify.com
APIFY_TOKEN=
APIFY_IG_ACTOR_ID=apify~instagram-scraper
APIFY_TIKTOK_ACTOR_ID=clockworks~tiktok-scraper
APIFY_ADLIBRARY_ACTOR_ID=apify~facebook-ads-scraper

# Supadata (transcripción/guion de videos) — supadata.ai
SUPADATA_API_KEY=

# Windsor.ai (reporte de TUS propias cuentas de Meta Ads / Google Ads) — windsor.ai
WINDSOR_API_KEY=

# Solo para producción 24/7 (ej. Railway/Render con volumen persistente).
# En local dejalas vacías: usa las carpetas del proyecto por defecto.
# DASHBOARD_DATA_DIR=/data
# DASHBOARD_MEDIA_DIR=/data/dashboard-media
